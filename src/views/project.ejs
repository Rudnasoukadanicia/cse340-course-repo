<%- include('partials/header') %>

    <main>
        <h1>
            <%= project.title %>
        </h1>

        <p><strong>Description:</strong>
            <%= project.description %>
        </p>
        <p><strong>Date:</strong>
            <%= project.date %>
        </p>
        <p><strong>Location:</strong>
            <%= project.location %>
        </p>

        <p>
            <strong>Organization:</strong>
            <a href="/organization/<%= project.organization_id %>">
                <%= project.organization_name %>
            </a>
        </p>

        <h3>Categories:</h3>

        <ul>
            <% categories.forEach(cat=> { %>
                <li>
                    <a href="/category/<%= cat.category_id %>">
                        <%= cat.name %>
                    </a>
                </li>
                <% }) %>
        </ul>
        <br>
        <% if (user && user.role_name==='admin' ) { %>
        <p>
            <a href="/edit-project/<%= project.project_id %>">
                Edit Project
                </a>
        </p>
        <% } %>
        
    <% if (user) { %>
    
        <% if (isVolunteer) { %>
    
            <form action="/project/<%= project.project_id %>/remove-volunteer" method="POST">
                <button type="submit">Remove Volunteer</button>
            </form>
    
            <% } else { %>
    
                <form action="/project/<%= project.project_id %>/volunteer" method="POST">
                    <button type="submit">Volunteer for this Project</button>
                </form>
    
                <% } %>
    
                    <% } %>

    </main>

    <%- include('partials/footer') %>