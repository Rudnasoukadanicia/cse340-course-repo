<%- include('partials/header') %>

    <main>
        
        <h1><%= category.name_categories %></h1>

        <ul>
            <% projects.forEach(project => { %>
                <li>
                    <a href="/project/<%= project.project_id %>"><%= project.title %></a>
                </li>
            <% }) %>
        </ul>
        <p><a href="/new-category">Add a new category</a></p>
        <p><a href="/edit-category/<%= category.categories_id %>">Edit Category</a></p>
    </main>

    <%- include('partials/footer') %>